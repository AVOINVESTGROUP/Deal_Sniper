# Локальная конфигурация Google Cloud
# Аутентификация выполняется через Application Default Credentials.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=your-region
DEPLOYMENT_ENVIRONMENT=local
PUBLISHER_JOB_NAME=deal-sniper-publisher
CLOUD_RUN_API_URL=
CLOUD_TASKS_LOCATION=your-region
TASK_INVOKER_SERVICE_ACCOUNT=
INTERNAL_TASK_SECRET=
DELIVERY_ENABLED=false
COLLECTOR_JOB_PREFIX=deal-sniper-collector
STORAGE_BACKEND=local
FIRESTORE_DATABASE=(default)
RAW_SNAPSHOTS_BUCKET=your-project-raw-snapshots
LOCAL_RAW_SNAPSHOTS_PATH=data/raw
LISTING_PROCESSING_QUEUE=listing-processing
TELEGRAM_DELIVERY_QUEUE=telegram-delivery
SCHEMA_VERSION=2
MIGRATION_TOOL_VERSION=1.1.0
GIT_COMMIT=local
RUNTIME_IMAGE_DIGEST=local
FINANCIAL_CONFIG_VERSION=provisional-2026-07-v1

# Параметры принятия решения
TARGET_PROFIT_AED=5000
MIN_ROI_PERCENT=10
MIN_COMPARABLES_COUNT=5
AED_TO_USD_RATE=3.6725

# Только для локального запуска Telegram-бота.
# В Google Cloud токен хранится в Secret Manager.
TELEGRAM_BOT_TOKEN=replace-locally
TELEGRAM_ALLOWED_USER_IDS=replace-locally
TELEGRAM_ADMIN_USER_IDS=replace-locally
ADMIN_EMAILS=admin@example.com
# Точные HTTPS origins через запятую; wildcard при Firebase Auth запрещён.
CORS_ALLOWED_ORIGINS=https://avo-deal-sniper.web.app,https://avo-deal-sniper.firebaseapp.com
TELEGRAM_CHANNEL_ID=
TELEGRAM_PRO_CHANNEL_ID=
TELEGRAM_PRO_SUBSCRIPTION_URL=
# Обязателен для staging delivery: production IDs, которые staging не вправе использовать.
PRODUCTION_TELEGRAM_CHANNEL_IDS=
# Исходный fallback до создания активной версии в R7 Control Center.
PRO_PRICE_AED=100
PRO_PRICE_STARS=1500
TELEGRAM_WEBHOOK_SECRET=

# Локальный запуск и первый реальный источник
LOCAL_DATABASE_PATH=data/deal_sniper.db
DUBICARS_URL_TEMPLATE=https://www.dubicars.com/uae/used?page={page}
DUBICARS_MAX_PAGES=3
CARSWITCH_URL_TEMPLATE=https://carswitch.com/dubai/used-cars/search?page={page}
CARSWITCH_MAX_PAGES=3
CARS24_URL_TEMPLATE=https://www.cars24.ae/buy-used-cars-dubai/?page={page}
CARS24_MAX_PAGES=3
OPENSOOQ_URL_TEMPLATE=https://ae.opensooq.com/en/cars/cars-for-sale?sort=recent&page={page}
OPENSOOQ_MAX_PAGES=5
REQUEST_TIMEOUT_SECONDS=30
DEFAULT_NON_PURCHASE_COST_AED=5000
CHANNEL_MAX_POSTS_PER_RUN=10
INSPECTION_COST_AED=500
PREPARATION_COST_AED=1500
BASE_REPAIR_RESERVE_AED=2500
REGISTRATION_COST_AED=800
REPAIR_LOW_AED=1000
REPAIR_EXPECTED_AED=2500
REPAIR_HIGH_AED=5000
HOLDING_COST_PER_DAY_AED=50
EXPECTED_HOLD_DAYS=45
ANNUAL_CAPITAL_RATE=0.08
SELLING_RATE=0.02
RISK_RATE=0.05
LIQUIDITY_DISCOUNT_RATE=0.05

# Добавляется только на этапе Telegram Mini App.
TMA_URL=

# Свежие англоязычные новости авторынка Дубая для диалога Telegram.
# Только прямая HTTPS RSS/Atom-лента издателя; Google News и другие агрегаторы отклоняются.
AUTO_NEWS_RSS_URL=
PRO_DEALS_ENABLED=true
PRO_NEWS_ENABLED=true
PRO_NEWS_MAX_ITEMS=3
PRO_NEWS_MIN_INTERVAL_HOURS=6
PRO_NEWS_AI_SUMMARY_ENABLED=false
VERTEX_AI_LOCATION=global
VERTEX_AI_MODEL=
AUTO_NEWS_MAX_AGE_DAYS=45
AUTO_NEWS_LIMIT=3
FREE_TEASER_IMAGE_URL=

# Официальный Meta adapter остаётся выключенным без внешних credentials.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
